{
  "name": "llama-prompt-studio",
  "version": "1.0.0",
  "description": "Mac app to communicate with local LLaMA models and generate Lovable AI prompts",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "preview": "vite preview",
    "package": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.llamaprompt.studio",
    "productName": "LLaMA Prompt Studio",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    }
  }
}
